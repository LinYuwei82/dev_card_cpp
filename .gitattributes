# web/ 是编译期内嵌资源：文件的字节就是产品的一部分
# （cmake/embed_web.cmake 把字节数/SHA256 写进生成代码，运行时与 ctest 再校验一次）。
# 所以不能让 git 在检出时替换换行：
#   - 文本资源强制 LF，Windows 与 macOS 检出后字节一致；
#   - 二进制资源显式标为二进制，禁止任何换行处理。
# cmake/embed_web.cmake 里另有一道 CR 检测，作为检出配置失灵时的兜底。
web/**     -text
web/*.html text eol=lf
web/*.css  text eol=lf
web/*.js   text eol=lf
web/js/*.js text eol=lf

# 发布门禁：三仓库共用同一份文件，字节必须跨平台一致（哈希校验依赖 LF）
tools/release/guard.py text eol=lf
tools/release/guard.sha256 text eol=lf
tools/release/manifest_v2.py text eol=lf
tools/release/manifest_v2.sha256 text eol=lf

# PowerShell 5 在 Windows 上只正确识别 UTF-8 + BOM 的 .ps1；
# UTF-8 无 BOM 会被当 GBK 读，中文字面量断裂导致脚本崩溃。
# 规则：统一用 UTF-8 + BOM，行尾 CRLF（PowerShell 习惯）。
# 真正的 BOM 门禁在 tools/hooks/pre-commit 里（提交即阻断）。
*.ps1 text eol=crlf working-tree-encoding=UTF-8
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
