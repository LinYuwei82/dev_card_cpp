#include <windows.h>

// 由 CMake 从 VERSION.txt 生成，不要手改。
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @DEVCARD_VERSION_COMMA@
 PRODUCTVERSION @DEVCARD_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Xiaotu Online"
            VALUE "LegalCopyright", "Copyright (C) 2026 Xiaotu Online"
            VALUE "FileDescription", "DevCard"
            VALUE "FileVersion", "@DEVCARD_VERSION_STRING@"
            VALUE "InternalName", "@DEVCARD_RC_FILENAME@"
            VALUE "OriginalFilename", "@DEVCARD_RC_FILENAME@"
            VALUE "ProductName", "DevCard"
            VALUE "ProductVersion", "@DEVCARD_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
