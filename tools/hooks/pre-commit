#!/usr/bin/env bash
# pre-commit hook — 多门禁（UTF-8 BOM + 清单公钥 hex + Sparkle 公钥）
#
# 门禁 1：PowerShell 5 .ps1 必须 UTF-8 + BOM
#         Windows PowerShell 5 只正确识别带 BOM 的 .ps1；
#         无 BOM 会被按 GBK 读，中文字面量断裂 → 脚本崩溃。
#
# 门禁 2：清单 v2 的 Ed25519 公钥（hex）一致性
#         分层重构后全仓只剩一处：/api/version 的 kUpdateSignPubkeyHex
#         （server/src/server.cpp）。Windows 更新桥 DEVCARD_UPDATER_PUBKEY_HEX
#         （shell/win/CMakeLists.txt）已随 updater_win 一起退役——win 壳不再
#         自己验签，公钥一致性由 server 单点保证。
#         有 ~/.config/devcard/manifest-keys/ed25519_seed.b64 时还会从种子推导
#         公钥核对，防止写错。混用 Sparkle 公钥会导致 SIGNATURE_INVALID。
#
# 门禁 3：Sparkle EdDSA 公钥硬编码一致性
#         Sparkle 验签公钥在 shell/CMakeLists.txt 硬编码一处，且会全仓扫描
#         已跟踪的代码/脚本里的所有 32 字节 base64 公钥；任一处被误改都会导致
#         客户端更新验签静默失败。这个 hook 从
#         ~/.config/devcard/sparkle-keys/private_key.pem
#         （或 DEVCARD_SIGNING_KEY 环境变量指定）推导出正确公钥，
#         和代码里硬编码的值比对。
#
# 用法：git config core.hooksPath tools/hooks（见 setup-hooks.ps1）。

set -u

RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'
RERUN="${YELLOW}git commit --no-verify${NC}"

# ============================================================
# 门禁 1：.ps1 UTF-8 + BOM
# ============================================================
fail_count=0; checked=0
# macOS 默认 bash 3.2 无 mapfile，用 while 兼容
ps1_list=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '\.ps1$' || true)

if [ -n "$ps1_list" ]; then
    echo -e "${YELLOW}[hook] 门禁 1/3：.ps1 UTF-8 + BOM${NC}"
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        bom=$(git show ":$f" 2>/dev/null | head -c 3 | od -An -tx1 | tr -d ' \n')
        checked=$((checked + 1))
        if [ "$bom" = "efbbbf" ]; then
            echo -e "  ${GREEN}✓${NC} $f"
        else
            echo -e "  ${RED}✗${NC} $f 缺少 UTF-8 BOM（当前前 3 字节：$bom）"
            fail_count=$((fail_count + 1))
        fi
    done <<< "$ps1_list"
    if [ $fail_count -gt 0 ]; then
        echo -e "${RED}[hook] 阻断：${fail_count}/${checked} 个 .ps1 缺 UTF-8 BOM${NC}"
        exit 1
    fi
    echo -e "  ${GREEN}✓ 通过：${checked} 个 .ps1${NC}\n"
else
    echo -e "${GREEN}[hook] 门禁 1/3 跳过（无 .ps1 变更）${NC}"
fi

# ============================================================
# 门禁 2：清单 v2 Ed25519 公钥（hex）一致性
# ============================================================
echo -e "${YELLOW}[hook] 门禁 2/3：清单 Ed25519 公钥（hex）一致性${NC}"

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 取某个标记后 3 行内的 64 位十六进制串（server 的常量值与名字分两行）
hex_after_marker() {
    grep -A3 -F "$2" "$1" 2>/dev/null \
        | grep -oE '"[0-9a-fA-F]{64}"' | head -1 | tr -d '"' | tr 'A-F' 'a-f'
}

SERVER_KEY_FILE="$REPO_ROOT/server/src/server.cpp"
SERVER_HEX=$(hex_after_marker "$SERVER_KEY_FILE" "kUpdateSignPubkeyHex")

hex_fail=0
if [ -z "$SERVER_HEX" ]; then
    echo -e "  ${RED}✗${NC} server/src/server.cpp 里找不到 kUpdateSignPubkeyHex 的 64 位 hex 公钥"
    hex_fail=$((hex_fail + 1))
fi
# updater_win 退役后 win 壳不再有第二处公钥；若 DEVCARD_UPDATER_PUBKEY_HEX
# 复现（有人把旧桥搬回来），这里拒绝。
if grep -q "DEVCARD_UPDATER_PUBKEY_HEX" "$REPO_ROOT/shell/win/CMakeLists.txt" 2>/dev/null; then
    echo -e "  ${RED}✗${NC} shell/win/CMakeLists.txt 又出现了 DEVCARD_UPDATER_PUBKEY_HEX"
    echo -e "     updater_win 已退役，清单验签只在 server 一处；win 壳不应再自带公钥。"
    hex_fail=$((hex_fail + 1))
fi

# 有签名种子时再从种子推导公钥核对（两处一起写错也能拦住）
SEED_FILE="$HOME/.config/devcard/manifest-keys/ed25519_seed.b64"
if [ -f "$SEED_FILE" ] && command -v openssl >/dev/null 2>&1 && command -v xxd >/dev/null 2>&1; then
    seed_hex=$(openssl base64 -d -A -in "$SEED_FILE" 2>/dev/null | xxd -p -c 64 | tr -d '\n')
    if [ "${#seed_hex}" -eq 64 ]; then
        # 32 字节种子包成 Ed25519 PKCS#8（302e020100300506032b657004220420），再取公钥末 32 字节
        derived_hex=$(printf '302e020100300506032b657004220420%s' "$seed_hex" \
            | xxd -r -p | openssl pkey -inform DER -pubout -outform DER 2>/dev/null \
            | tail -c 32 | xxd -p -c 64 | tr -d '\n')
        if [ -n "$derived_hex" ] && [ -n "$SERVER_HEX" ] && [ "$derived_hex" != "$SERVER_HEX" ]; then
            echo -e "  ${RED}✗${NC} 清单公钥与签名种子推导值不一致："
            echo -e "     种子推导：$derived_hex"
            echo -e "     代码硬编码：$SERVER_HEX"
            hex_fail=$((hex_fail + 1))
        fi
    fi
else
    echo -e "  ${YELLOW}⚠${NC} 跳过种子推导核对（缺 $SEED_FILE 或 openssl/xxd）"
fi

if [ $hex_fail -eq 0 ]; then
    echo -e "  ${GREEN}✓ 通过：清单公钥 hex 一致${NC}\n"
else
    echo ""
    echo -e "${RED}[hook] 阻断：清单公钥 hex 校验失败（$hex_fail 处）${NC}"
    echo -e "       写错会让 Windows「检查更新」恒定 SIGNATURE_INVALID。"
    echo -e "       绕过：$RERUN"
    exit 1
fi

# ============================================================
# 门禁 3：Sparkle Ed25519 公钥一致性
# ============================================================
echo -e "${YELLOW}[hook] 门禁 3/3：Sparkle Ed25519 公钥一致性${NC}"

REPO_ROOT="$(git rev-parse --show-toplevel)"
# DevCard Sparkle 用 .pem
KEY_FILE="${DEVCARD_SIGNING_KEY:-$HOME/.config/devcard/sparkle-keys/private_key.pem}"

if [ ! -f "$KEY_FILE" ]; then
    echo -e "  ${YELLOW}⚠ 跳过：Sparkle 私钥不存在 $KEY_FILE${NC}"
    echo -e "     设置 DEVCARD_SIGNING_KEY=/path/to/private_key.pem 或确保默认位置存在。"
    exit 0
fi

# 从 .pem 推公钥
if command -v openssl >/dev/null 2>&1; then
    CORRECT_PUBKEY=$(openssl pkey -in "$KEY_FILE" -pubout -outform DER 2>/dev/null | tail -c 32 | base64 | tr -d '\n')
    if [ -z "$CORRECT_PUBKEY" ]; then
        echo -e "  ${YELLOW}⚠ 跳过：openssl 推导出公钥为空${NC}"
        exit 0
    fi
else
    echo -e "  ${YELLOW}⚠ 跳过：系统无 openssl${NC}"
    exit 0
fi

echo "  正确公钥（从私钥推导）：$CORRECT_PUBKEY"

# 需要包含正确公钥的文件
TARGET_FILES=(
    "shell/CMakeLists.txt"
)
# docs/ 扫描（仅提示）
DOCS_GLOB="docs/*.md docs/**/*.md"

# 广扫：所有已跟踪的代码/脚本/配置（排除 build/dist/3rdparty/vendor 与 docs/）里出现的
# 32 字节 base64 公钥，只要不是正确值就阻断——新增文件硬编码错公钥也会被拦下。
# 只把 base64 解码后正好 32 字节的当公钥（签名是 64 字节，自动排除），减少误判。
# docs/ 仍只提示（文档可能记录历史密钥，需人工核对）。
echo ""
echo -e "  ${YELLOW}— 全仓扫描（代码/脚本，阻断）—${NC}"
scan_files=$(git ls-files \
    | grep -vE '(^|/)(build|dist|3rdparty|vendor|\.git)/' \
    | grep -vE '^docs/' \
    | grep -E '(^|/)(CMakeLists\.txt|.*\.(txt|sh|cmake|plist|py|yml|yaml|json|iss|ps1))$' || true)
scan_fail=0
if [ -n "$scan_files" ]; then
    while IFS= read -r f; do
        [ -f "$REPO_ROOT/$f" ] || continue
        hits=$(grep -oE '[A-Za-z0-9+/]{43}=' "$REPO_ROOT/$f" 2>/dev/null | sort -u || true)
        [ -z "$hits" ] && continue
        while IFS= read -r tok; do
            [ -z "$tok" ] && continue
            [ "$tok" = "$CORRECT_PUBKEY" ] && continue
            tok_size=$(printf '%s' "$tok" | openssl base64 -d -A 2>/dev/null | wc -c | tr -d ' ')
            [ "$tok_size" = "32" ] || continue
            echo -e "  ${RED}✗${NC} $f 出现非预期公钥：$tok"
            scan_fail=$((scan_fail + 1))
        done <<< "$hits"
    done <<< "$scan_files"
fi
if [ $scan_fail -eq 0 ]; then
    echo -e "  ${GREEN}✓ 通过：代码/脚本里的公钥均为正确值${NC}"
fi

target_fail=0
for f in "${TARGET_FILES[@]}"; do
    [ -f "$REPO_ROOT/$f" ] || { echo -e "  ${YELLOW}⚠${NC} $f 不存在"; continue; }
    STAGED=$(git show ":$f" 2>/dev/null || cat "$REPO_ROOT/$f" 2>/dev/null || true)
    if echo "$STAGED" | grep -qF "$CORRECT_PUBKEY"; then
        echo -e "  ${GREEN}✓${NC} $f"
    else
        ANY_KEY=$(echo "$STAGED" | grep -oE '[A-Za-z0-9+/]{43}=' | head -1 || true)
        if [ -n "$ANY_KEY" ] && [ "$ANY_KEY" != "$CORRECT_PUBKEY" ]; then
            echo -e "  ${RED}✗${NC} $f 出现公钥但与正确值不一致："
            echo -e "     正确：$CORRECT_PUBKEY"
            echo -e "     当前：$ANY_KEY"
            target_fail=$((target_fail + 1))
        else
            echo -e "  ${YELLOW}⚠${NC} $f 未出现任何 Ed25519 公钥（确认是否应包含）"
        fi
    fi
done

# docs 扫描（提示但不阻断）
echo ""
echo -e "  ${YELLOW}— docs/ 扫描（仅提示，不阻断）—${NC}"
for pat in $DOCS_GLOB; do
    for f in $REPO_ROOT/$pat; do
        [ -f "$f" ] || continue
        HIT=$(grep -nE '[A-Za-z0-9+/]{43}=' "$f" 2>/dev/null | grep -v "$CORRECT_PUBKEY" | head -2 || true)
        if [ -n "$HIT" ]; then
            echo -e "  ${YELLOW}ℹ${NC} $f 里有疑似公钥需要核对："
            echo "$HIT" | sed 's/^/     /'
        fi
    done
done

if [ $((target_fail + scan_fail)) -gt 0 ]; then
    echo ""
    echo -e "${RED}[hook] 阻断：$((target_fail + scan_fail)) 处硬编码公钥与 Sparkle 私钥不一致${NC}"
    echo -e "       错公钥会导致 Sparkle 验签失败，客户端更新静默拒绝。"
    echo -e "       密钥文件：$KEY_FILE"
    echo -e "       绕过：$RERUN"
    exit 1
fi

echo ""
echo -e "${GREEN}[hook] 通过：门禁 1/3 + 门禁 2/3 + 门禁 3/3${NC}"
exit 0
